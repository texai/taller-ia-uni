{
  "name": "taller-ia-uni",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de dictado en vivo · Taller 02 de caso aplicado de IA en industria · UNI",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validar-contenido && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validar-contenido": "tsx scripts/validar-contenido.ts",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "humo": "node --import tsx scripts/humo.mjs",
    "qr": "node --import tsx scripts/generar-qr.mjs",
    "qr:leer": "node --import tsx scripts/verificar-qr.mjs",
    "numerar": "tsx scripts/numerar-codigo.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "js-yaml": "^5.2.3",
    "mermaid": "^11.16.1",
    "next": "^16.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.9",
    "typescript": "^5.7.2"
  }
}
