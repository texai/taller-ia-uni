# Copia este archivo a .env.local y completa con los valores reales.
#
#   cp .env.example .env.local
#
# .env.local esta en .gitignore y no debe versionarse nunca.

# --------------------------------------------------------------------------
# Supabase
# --------------------------------------------------------------------------
# El proyecto es COMPARTIDO con la aplicacion `gen`. Ver docs/CONVENTIONS.md
# §11 antes de crear tablas o tocar politicas.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Llave publicable. Llega al navegador y esta bien que asi sea: lo que protege
# los datos son las politicas de fila, no el secreto de esta llave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Llave de servicio. SALTA TODAS LAS POLITICAS. Solo en el servidor y en los
# scripts de mantenimiento; jamas en un componente cliente ni en el repo.
# En Vercel va como variable de entorno del proyecto, no en el codigo.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --------------------------------------------------------------------------
# Docente
# --------------------------------------------------------------------------
# Correo del unico usuario que puede dictar. `npm run clave-docente` lo crea o
# le cambia la contraseña.
DOCENTE_EMAIL=
