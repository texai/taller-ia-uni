# Copia este archivo a .env.local y completa con los valores reales.
#
#   cp .env.example .env.local
#
# .env.local esta en .gitignore y no debe versionarse nunca.

# --------------------------------------------------------------------------
# Supabase
# --------------------------------------------------------------------------
# El proyecto es COMPARTIDO con la aplicacion `gen`. Se usa solo para dos
# cosas: Auth y Realtime. No hay tablas nuestras.
# Ver docs/CONVENTIONS.md §11.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Llave publicable. Llega al navegador y esta bien que asi sea.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Identificador del usuario docente, tal como aparece en Authentication -> Users.
# No es un secreto: sirve para que la interfaz sepa a quien mostrar los
# controles. La defensa real es la politica sobre realtime.messages, que usa
# este mismo identificador.
NEXT_PUBLIC_DOCENTE_UID=

# --------------------------------------------------------------------------
# Solo servidor
# --------------------------------------------------------------------------
# Llave de servicio. SALTA TODAS LAS POLITICAS de todo el proyecto, incluidas
# las tablas de `gen`. Jamas en un componente cliente ni en el repositorio.
# Hoy la aplicacion no la necesita; queda documentada por si algun script de
# mantenimiento llega a hacer falta.
SUPABASE_SERVICE_ROLE_KEY=
